# Database (PostgreSQL + PostGIS)
DIRTBAG_DATABASE_URL=postgresql+psycopg://dirtbag:dirtbag@localhost:5433/dirtbag

# Object storage for RAW snapshots (local path in development)
DIRTBAG_RAW_STORAGE_PATH=./data/local/raw

# HTTP crawler behavior (be polite: conservative defaults)
DIRTBAG_HTTP_TIMEOUT=20
DIRTBAG_HTTP_MAX_RETRIES=3
DIRTBAG_HTTP_RATE_LIMIT_SECONDS=1.5
DIRTBAG_HTTP_USER_AGENT=DirtBagBot/0.1 (+https://dirtbag.vercel.app)

# Config
DIRTBAG_CONFIG=configs/development.yaml
